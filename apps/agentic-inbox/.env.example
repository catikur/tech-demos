# Copy to .env — every variable is optional. With none set the app runs in demo mode.

# --- server ---
PORT=3000
APP_BASE_URL=http://localhost:3000        # must match the OAuth redirect URIs you register
DATA_DIR=./data                           # SQLite db, recordings, generated token key
# TOKEN_ENCRYPTION_KEY=                   # base64 32 bytes; generated into data/.token-key when omitted

# --- Microsoft 365 (docs/microsoft-365.md) ---
# MS_CLIENT_ID=
# MS_TENANT_ID=common                     # tenant id, "organizations" or "common"
# MS_CLIENT_SECRET=                       # optional; PKCE public client works without it
# GRAPH_WEBHOOK_SECRET=                   # clientState for Graph push; auto-generated if omitted (HTTPS APP_BASE_URL only)
# MS_PLANNER_PLAN_ID=                     # optional; also create a Planner task when pushing to To Do

# --- Gmail / Google Calendar (docs/gmail.md) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR=true

# --- Agent model (any one; none = rule-based fallback) ---
LLM_PROVIDER=auto                         # auto | openai | anthropic | mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # Azure OpenAI / Ollama / vLLM: point here (no key needed for local)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- scheduler ---
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=5
BRIEF_LEAD_MINUTES=15
DIGEST_EMAIL_TO_SELF=false                # also mail each digest to the space's own address
